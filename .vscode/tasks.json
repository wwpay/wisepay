{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "git pull on startup",
      "type": "shell",
      "command": "Start-Sleep 3; git pull; if ($LASTEXITCODE -ne 0) { Start-Sleep 5; git pull }",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
